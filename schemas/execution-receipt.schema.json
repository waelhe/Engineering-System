{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EGM Execution Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "repository",
    "tier",
    "status",
    "head_sha",
    "started_at",
    "knowledge_pack",
    "checks",
    "reviews",
    "write_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "project_id": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "pull_request": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "branch": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3"
      ]
    },
    "status": {
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "implemented",
        "verified",
        "merged",
        "deployed"
      ]
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tested_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "write_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_pack": {
      "type": "object",
      "required": [
        "generated_at",
        "record_ids"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "not_run",
              "queued",
              "in_progress",
              "success",
              "failure",
              "cancelled",
              "skipped",
              "blocked"
            ]
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tested_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "success"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "tested_sha",
                "url"
              ],
              "properties": {
                "tested_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "url": {
                  "pattern": "^https://github\\.com(?::443)?/[^/]+/[^/]+/actions/runs/[0-9]+(?:/.*)?$",
                  "type": "string"
                }
              },
              "required": [
                "url"
              ]
            },
            "then": {
              "required": [
                "run_id"
              ],
              "properties": {
                "run_id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            }
          }
        ]
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "status"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "status": {
            "enum": [
              "not_run",
              "queued",
              "in_progress",
              "completed",
              "blocked",
              "failed"
            ]
          },
          "independence_proof": {
            "type": [
              "string",
              "null"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewed_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "decision",
          "actor",
          "at"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "approved",
              "rejected",
              "waived"
            ]
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_inclusion": {
      "type": "object",
      "required": [
        "target_branch",
        "target_sha",
        "tested_sha",
        "candidate_inclusion",
        "tested_sha_is_ancestor",
        "comparison_status",
        "ahead_by",
        "behind_by",
        "proof_url",
        "target_verification",
        "target_branch_proof"
      ],
      "properties": {
        "target_branch": {
          "type": "string"
        },
        "target_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tested_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate_inclusion": {
          "type": "object",
          "required": [
            "head_sha",
            "tested_sha",
            "head_sha_is_ancestor",
            "comparison_status",
            "ahead_by",
            "behind_by",
            "proof_url"
          ],
          "properties": {
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "tested_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "head_sha_is_ancestor": {
              "const": true
            },
            "comparison_status": {
              "enum": [
                "ahead",
                "identical"
              ]
            },
            "ahead_by": {
              "type": "integer",
              "minimum": 0
            },
            "behind_by": {
              "const": 0
            },
            "proof_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "additionalProperties": false
        },
        "comparison_status": {
          "enum": [
            "ahead",
            "identical"
          ]
        },
        "ahead_by": {
          "type": "integer",
          "minimum": 0
        },
        "behind_by": {
          "const": 0
        },
        "target_verification": {
          "type": "object",
          "required": [
            "workflow"
          ],
          "properties": {
            "workflow": {
              "type": "object",
              "required": [
                "name",
                "run_id",
                "conclusion",
                "tested_sha",
                "url",
                "source"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "conclusion": {
                  "const": "success"
                },
                "tested_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "source": {
                  "type": "object",
                  "required": [
                    "kind",
                    "uri",
                    "run_id",
                    "commit_sha",
                    "captured_at"
                  ],
                  "properties": {
                    "kind": {
                      "const": "ci_run"
                    },
                    "uri": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commit_sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "captured_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "tested_sha_is_ancestor": {
          "const": true
        },
        "proof_url": {
          "type": "string",
          "minLength": 1
        },
        "target_branch_proof": {
          "type": "object",
          "required": [
            "kind",
            "branch",
            "commit_sha",
            "uri",
            "captured_at"
          ],
          "properties": {
            "kind": {
              "const": "github_branch_ref"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "uri": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "captured_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "environment",
          "status",
          "commit_sha",
          "url",
          "at"
        ],
        "properties": {
          "environment": {
            "type": "string"
          },
          "status": {
            "enum": [
              "success",
              "failure",
              "rolled_back"
            ]
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "url": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "merged",
              "deployed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "tested_sha"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "merged",
              "deployed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "target_inclusion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deployed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deployments"
        ]
      }
    }
  ]
}
