{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PEOS current evidence snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "snapshot_date",
    "sources",
    "records",
    "anomalies",
    "assessment"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "w5_backend_commerce_snapshot",
        "w6_client_delivery_snapshot",
        "w7_operations_snapshot",
        "w3_pr_queue_snapshot"
      ]
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "system",
          "capture_method"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "capture_method": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": true,
        "anyOf": [
          {
            "required": [
              "repository"
            ]
          },
          {
            "required": [
              "reference"
            ]
          }
        ]
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assessment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 4
          },
          "assessment": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": true
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment": {
      "type": "string",
      "minLength": 20
    }
  },
  "additionalProperties": true
}
